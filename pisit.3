-- ใช้ task.spawn เพื่อรันพร้อมกันแบบเร็วที่สุด
local successCount = 0
local totalFiles = #urls
local startTime = tick()

-- สร้างฟังก์ชันโหลดแบบเร็ว
local function loadFile(url, index)
    local success, data = pcall(function()
        return game:HttpGet(url, true)
    end)
    
    if success and data and #data > 10 then
        local func = loadstring(data)
        if func then
            successCount = successCount + 1
            pcall(func)
        end
    end
end

-- รันทุกไฟล์พร้อมกันด้วย task.spawn (เร็วที่สุด)
for i, url in ipairs(urls) do
    task.spawn(function()
        loadFile(url, i)
    end)
end

-- รอให้โหลดเสร็จภายใน 0.1-0.5 วินาที
local timeout = 0.1 -- 0.1 วินาที
local checkInterval = 0.001 -- ตรวจสอบทุก 1ms

repeat
    task.wait(checkInterval)
until successCount >= totalFiles or tick() - startTime > timeout

print("🎯 โหลดเสร็จ " .. successCount .. "/" .. totalFiles .. " ไฟล์ ใน " .. (tick() - startTime) .. " วินาที")