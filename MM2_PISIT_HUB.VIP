local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- ลบ UI เก่าทิ้งเพื่อป้องกันบั๊กซ้อนทับ
pcall(function()
    if CoreGui:FindFirstChild("PisitSecurityScanner") then CoreGui.PisitSecurityScanner:Destroy() end
    if PlayerGui:FindFirstChild("SiaBeamExecutor_UI") then PlayerGui.SiaBeamExecutor_UI:Destroy() end
    if CoreGui:FindFirstChild("SiaBeamExecutor_UI") then CoreGui.SiaBeamExecutor_UI:Destroy() end
end)

----------------------------------------------------------------
-- 1. Main ScreenGui & Base UI Structure (ธีมแดง-ดำ PISIT HUB x pisit)
----------------------------------------------------------------
local DeltaExecutor = Instance.new("ScreenGui")
DeltaExecutor.Name = "SiaBeamExecutor_UI"
DeltaExecutor.Parent = (pcall(function() return gethui() end) and gethui() or PlayerGui)
DeltaExecutor.ResetOnSpawn = false
DeltaExecutor.DisplayOrder = 999999
DeltaExecutor.IgnoreGuiInset = true

-- ปุ่มลอยเปิด/ปิด UI หลัก (แดง-ดำ)
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Name = "ToggleBtn"
ToggleBtn.Size = UDim2.new(0, 48, 0, 48)
ToggleBtn.Position = UDim2.new(0, 15, 0.5, -24)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
ToggleBtn.Text = "PISIT"
ToggleBtn.TextColor3 = Color3.fromRGB(220, 20, 60)
ToggleBtn.TextSize = 11
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.Active = true
ToggleBtn.Draggable = true
ToggleBtn.Parent = DeltaExecutor
Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 10)

local ToggleStroke = Instance.new("UIStroke", ToggleBtn)
ToggleStroke.Color = Color3.fromRGB(220, 20, 60)
ToggleStroke.Thickness = 1.5

-- หน้าต่างหลัก (แดง-ดำ)
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 520, 0, 320)
MainFrame.Position = UDim2.new(0.5, -260, 0.5, -160)
MainFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Visible = true
MainFrame.Parent = DeltaExecutor
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 12)

local MainStroke = Instance.new("UIStroke", MainFrame)
MainStroke.Color = Color3.fromRGB(200, 20, 50)
MainStroke.Thickness = 1.8

-- Header
local Header = Instance.new("Frame", MainFrame)
Header.Name = "Header"
Header.Size = UDim2.new(1, 0, 0, 40)
Header.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
Instance.new("UICorner", Header).CornerRadius = UDim.new(0, 12)

local Title = Instance.new("TextLabel", Header)
Title.Name = "Title"
Title.Size = UDim2.new(1, -50, 1, 0)
Title.Position = UDim2.new(0, 15, 0, 0)
Title.BackgroundTransparency = 1
Title.Text = "🔥 PISIT HUB x pisit | MM2 VIP"
Title.TextColor3 = Color3.fromRGB(230, 30, 60)
